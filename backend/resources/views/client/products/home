    <script>
        function handleBuy() {
            let data = {
                id: {{ $product->id }},
                quantity: 1,
                data_input: $('#data_input').val(),
            }
            $.ajax({
                url: '{{ route('request-product') }}',
                type: 'POST',
                data: data,
                dataType: 'json',
                beforeSend: function(xhr) {
                    $.blockUI({
                        message: '<i class="fa fa-spinner fa-spin"></i> Đang xử lý...',
                        css: {
                            border: 'none',
                            backgroundColor: 'transparent',
                            color: '#fff',
                            zIndex: 99999,
                        },
                        overlayCSS: {
                            backgroundColor: '#000',
                            opacity: 0.5,
                            cursor: 'wait'
                        }
                    });
                },
                complete: function() {
                    $.unblockUI();
                    $('#addToCartModal').modal('hide');
                },
                success: function(response) {
                    if (response.success == true) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: response.message,
                        }).then(function() {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: response.message,
                        });
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: xhr.responseJSON.message || 'Có lỗi xảy ra, vui lòng thử lại sau.',
                    });
                }
            });
        }
    </script>
